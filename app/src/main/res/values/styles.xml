<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="font_medium" translatable="false">sans-serif-medium</string>
    <string name="font_regular" translatable="false">sans-serif</string>

    <style name="SealCoffeeButtonPrimary">
        <item name="android:background">@drawable/bg_button_primary_navy</item>
        <item name="android:fontFamily">@string/font_medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="SealCoffeeButtonCream">
        <item name="android:background">@drawable/bg_button_cream</item>
        <item name="android:fontFamily">@string/font_medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/seal_navy</item>
    </style>

    <style name="SealCoffeeEditText">
        <item name="android:background">@drawable/bg_input_rounded</item>
        <item name="android:fontFamily">@string/font_regular</item>
        <item name="android:textColor">@color/seal_text_primary</item>
        <item name="android:textColorHint">@color/seal_text_secondary</item>
    </style>

    <style name="SealCoffeeCard">
        <item name="android:background">@drawable/bg_card_rounded</item>
        <item name="android:elevation">4dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:translationZ">1dp</item>
    </style>
</resources>
