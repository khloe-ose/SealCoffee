<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/seal_input_fill" />
            <stroke
                android:width="2dp"
                android:color="@color/seal_navy" />
            <padding
                android:bottom="14dp"
                android:left="16dp"
                android:right="16dp"
                android:top="14dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/seal_input_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/seal_input_stroke" />
            <padding
                android:bottom="14dp"
                android:left="16dp"
                android:right="16dp"
                android:top="14dp" />
        </shape>
    </item>
</selector>
