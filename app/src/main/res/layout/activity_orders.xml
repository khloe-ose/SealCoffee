<?xml version="1.0" encoding="utf-8"?>

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/seal_surface"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/ordersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- HEADER -->
            <TextView
                android:id="@+id/ordersTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Orders"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter"
                android:textColor="@android:color/black"
                android:layout_marginBottom="16dp"/>

            <!-- CURRENT ORDERS SECTION -->
            <TextView
                android:id="@+id/currentOrdersHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Orders"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/currentOrdersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="@android:color/white"
                android:layout_marginBottom="20dp" />

            <!-- COMPLETED ORDERS SECTION -->
            <TextView
                android:id="@+id/completedOrdersHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completed Orders"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/completedOrdersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="@android:color/white" />

        </LinearLayout>

    </ScrollView>