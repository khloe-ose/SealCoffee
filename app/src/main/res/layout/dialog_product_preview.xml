<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/seal_surface"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/previewImagePlaceholder"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_image_placeholder"
        android:contentDescription="@string/menu_item_image" />

    <TextView
        android:id="@+id/previewNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@color/seal_text_primary"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/previewDescriptionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/seal_text_secondary"
        android:textSize="15sp" />
</LinearLayout>
