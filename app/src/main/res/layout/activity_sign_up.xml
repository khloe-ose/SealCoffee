<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".SignUpActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/signUpRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/seal_navy">

        <View
            android:id="@+id/topSpace"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/cardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F2F1EB"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="36dp"
            android:paddingEnd="28dp"
            android:paddingBottom="36dp"
            app:layout_constraintTop_toBottomOf="@id/topSpace"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/signUpHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_extrabold"
                android:text="@string/sign_up"
                android:textColor="@color/seal_navy"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/signUpSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/sign_up_message"
                android:textColor="@color/seal_text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/first_name_label"
                        android:textColor="@color/seal_navy"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/firstNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="4dp"
                        android:autofillHints="givenName"
                        android:background="@drawable/bg_input_rounded"
                        android:hint="@string/first_name"
                        android:inputType="textPersonName"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="@color/seal_navy"
                        android:textColorHint="#757575"
                        android:textSize="14sp"
                        tools:ignore="VisualLintTextFieldSize" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/last_name_label"
                        android:textColor="@color/seal_navy"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/lastNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="4dp"
                        android:autofillHints="familyName"
                        android:background="@drawable/bg_input_rounded"
                        android:hint="@string/last_name"
                        android:inputType="textPersonName"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="@color/seal_navy"
                        android:textColorHint="#757575"
                        android:textSize="14sp"
                        tools:ignore="VisualLintTextFieldSize" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/birthdate"
                android:textColor="@color/seal_navy"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/birthdateInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:autofillHints="birthDateFull"
                android:background="@drawable/bg_input_rounded"
                android:hint="@string/birthdate"
                android:inputType="date"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/seal_navy"
                android:textColorHint="#757575"
                android:textSize="14sp"
                tools:ignore="VisualLintTextFieldSize" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/email_address"
                android:textColor="@color/seal_navy"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/signUpEmailInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_input_rounded"
                android:hint="@string/email_address"
                android:inputType="textEmailAddress"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/seal_navy"
                android:textColorHint="#757575"
                android:textSize="14sp"
                tools:ignore="VisualLintTextFieldSize" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/contact_number"
                android:textColor="@color/seal_navy"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/contactNumberInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:autofillHints="phone"
                android:background="@drawable/bg_input_rounded"
                android:hint="@string/contact_number"
                android:inputType="phone"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/seal_navy"
                android:textColorHint="#757575"
                android:textSize="14sp"
                tools:ignore="VisualLintTextFieldSize" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/password_label"
                android:textColor="@color/seal_navy"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/signUpPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:autofillHints="newPassword"
                android:background="@drawable/bg_input_rounded"
                android:hint="@string/password_hint"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/seal_navy"
                android:textColorHint="#757575"
                android:textSize="14sp"
                tools:ignore="VisualLintTextFieldSize" />

            <Button
                android:id="@+id/createAccountButton"
                style="@style/SealCoffeeButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:text="@string/create_account"
                android:textSize="18sp"
                tools:ignore="VisualLintButtonSize" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:fontFamily="@font/inter_medium"
                    android:text="@string/login_question"
                    android:textColor="@color/seal_text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/loginLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/log_in_link"
                    android:textColor="@color/seal_navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>