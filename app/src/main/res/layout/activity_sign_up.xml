<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/signUpRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".SignUpActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="54dp"
        android:paddingEnd="28dp"
        android:paddingBottom="36dp">

        <TextView
            android:id="@+id/signUpHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="@string/sign_up"
            android:textColor="@color/seal_navy"
            android:textSize="36sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/first_name_label"
            android:textColor="@color/seal_navy"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <EditText
            android:id="@+id/firstNameInput"
            style="@style/SealCoffeeEditText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:autofillHints="givenName"
            android:hint="@string/first_name"
            android:inputType="textPersonName"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/last_name_label"
            android:textColor="@color/seal_navy"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <EditText
            android:id="@+id/lastNameInput"
            style="@style/SealCoffeeEditText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:autofillHints="familyName"
            android:hint="@string/last_name"
            android:inputType="textPersonName"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/birthdate"
            android:textColor="@color/seal_navy"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <EditText
            android:id="@+id/birthdateInput"
            style="@style/SealCoffeeEditText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:autofillHints="birthDateFull"
            android:hint="@string/birthdate"
            android:inputType="date"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/email_address"
            android:textColor="@color/seal_navy"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <EditText
            android:id="@+id/signUpEmailInput"
            style="@style/SealCoffeeEditText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:autofillHints="emailAddress"
            android:hint="@string/email_address"
            android:inputType="textEmailAddress"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/contact_number"
            android:textColor="@color/seal_navy"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <EditText
            android:id="@+id/contactNumberInput"
            style="@style/SealCoffeeEditText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:autofillHints="phone"
            android:hint="@string/contact_number"
            android:inputType="phone"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/password_label"
            android:textColor="@color/seal_navy"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <EditText
            android:id="@+id/signUpPasswordInput"
            style="@style/SealCoffeeEditText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:autofillHints="newPassword"
            android:hint="@string/password_hint"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/createAccountButton"
            style="@style/SealCoffeeButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="@string/create_account"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:fontFamily="@font/inter_medium"
                android:text="@string/login_question"
                android:textColor="@color/seal_text_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/loginLink"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:minWidth="48dp"
                android:text="@string/log_in_link"
                android:textColor="@color/seal_navy"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
