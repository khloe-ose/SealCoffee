<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/SealCoffeeCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/menuItemImagePlaceholder"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:background="@drawable/bg_image_placeholder"
        android:scaleType="centerCrop"
        android:contentDescription="@string/menu_item_image"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/menuItemNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="@color/seal_text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/menuItemCategoryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/seal_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/menuItemPriceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/seal_navy"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/menuItemAvailabilityText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
