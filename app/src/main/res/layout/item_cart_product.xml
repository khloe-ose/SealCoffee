<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="10dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/cartItemNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:textColor="@color/seal_text_primary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/cartItemMetaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/seal_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cartItemPriceText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_semibold"
            android:textColor="@color/seal_navy"
            android:textSize="16sp" />

        <Button
            android:id="@+id/cartDecreaseButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="-"
            android:textSize="18sp"
            android:textColor="@color/seal_navy"
            android:includeFontPadding="false"/>



        <TextView
            android:id="@+id/cartItemQuantityText"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:textColor="@color/seal_text_primary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/cartIncreaseButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/holo_red_dark"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="+"
            android:textSize="18sp"
            android:textColor="@color/seal_navy"
            android:includeFontPadding="false"/>
    </LinearLayout>

    <TextView
        android:id="@+id/cartEditButton"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center_vertical"
        android:text="Edit item"
        android:textColor="@color/seal_coffee"
        android:textSize="14sp" />
</LinearLayout>
