<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/productDetailsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/seal_cream"
    tools:context=".ProductDetailsActivity">

    <LinearLayout
        android:id="@+id/productHeaderLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/seal_cream"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/productBackButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="@color/seal_navy" />

        <TextView
            android:id="@+id/productDetailsTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/inter_bold"
            android:text="@string/product_details"
            android:textColor="@color/seal_text_primary"
            android:textSize="26sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/productDetailsScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/seal_cream"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/productHeaderLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="40dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/seal_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/seal_card_stroke"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/productImagePlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/menu_item_image"
                    android:scaleType="fitCenter" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/productNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/seal_text_primary"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/productCategoryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter"
                android:textColor="@color/seal_coffee"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/productDescriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/inter"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/seal_text_secondary"
                android:textSize="16sp" />

            <!-- Ingredients Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/inter_bold"
                android:text="@string/ingredients"
                android:textColor="@color/seal_text_primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/productIngredientsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/inter"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/seal_text_secondary"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/productSizeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/size"
                    android:textColor="@color/seal_text_primary"
                    android:textSize="20sp" />

                <RadioGroup
                    android:id="@+id/productSizeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/productSizeRegular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:fontFamily="@font/inter"
                        android:text="@string/size_regular"
                        android:textColor="@color/seal_text_primary" />

                    <RadioButton
                        android:id="@+id/productSizeLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:fontFamily="@font/inter"
                        android:text="@string/size_large_price"
                        android:textColor="@color/seal_text_primary" />
                </RadioGroup>
            </LinearLayout>

            <EditText
                android:id="@+id/productNotesInput"
                style="@style/SealCoffeeEditText"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/inter"
                android:hint="@string/order_notes_optional"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="200"
                android:paddingHorizontal="16dp"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/productAddOnsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/addOnsHeaderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/add_ons"
                    android:textColor="@color/seal_text_primary"
                    android:textSize="20sp" />

                <LinearLayout
                    android:id="@+id/coffeeAddOnsGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/addOnExtraShotCheckBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:text="@string/add_on_extra_shot_price"
                        android:textColor="@color/seal_text_primary" />

                    <CheckBox
                        android:id="@+id/addOnOatMilkCoffeeCheckBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:text="@string/add_on_oat_milk_price"
                        android:textColor="@color/seal_text_primary" />

                    <CheckBox
                        android:id="@+id/addOnCaramelCheckBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:text="@string/add_on_caramel_price"
                        android:textColor="@color/seal_text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nonCoffeeAddOnsGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/addOnExtraMatchaCheckBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:text="@string/extra_matcha_30_00"
                        android:textColor="@color/seal_text_primary" />

                    <CheckBox
                        android:id="@+id/addOnOatMilkNonCoffeeCheckBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:text="@string/add_on_oat_milk_price"
                        android:textColor="@color/seal_text_primary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/quantity"
                    android:textColor="@color/seal_text_primary"
                    android:textSize="20sp" />

                <ImageButton
                    android:id="@+id/productDecreaseButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/decrease_quantity"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_decrease_btn" />

                <TextView
                    android:id="@+id/productQuantityText"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="center"
                    android:textColor="@color/seal_text_primary"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/productIncreaseButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/increase_quantity"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_increase_btn" />
            </LinearLayout>

            <TextView
                android:id="@+id/productPriceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/seal_navy"
                android:textSize="26sp" />

            <Button
                android:id="@+id/addToCartButton"
                style="@style/SealCoffeeButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/inter_bold"
                android:text="@string/add_to_cart"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>