<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/productDetailsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProductDetailsActivity">

    <TextView
        android:id="@+id/productDetailsTitleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/inter_extrabold"
        android:text="@string/product_details"
        android:textColor="@color/seal_text_primary"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/productDetailsScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/customerNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/productDetailsTitleText">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:paddingBottom="22dp">

            <ImageView
                android:id="@+id/productImagePlaceholder"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_image_placeholder"
                android:contentDescription="@string/menu_item_image"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/productNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/seal_text_primary"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/productCategoryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/seal_coffee"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/productDescriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/seal_text_secondary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/inter_semibold"
                android:text="@string/ingredients"
                android:textColor="@color/seal_text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/productIngredientsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/seal_text_secondary"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/productSizeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/size"
                    android:textColor="@color/seal_text_primary"
                    android:textSize="18sp" />

                <RadioGroup
                    android:id="@+id/productSizeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/productSizeRegular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/size_regular" />

                    <RadioButton
                        android:id="@+id/productSizeLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:text="@string/size_large_price" />
                </RadioGroup>
            </LinearLayout>

            <EditText
                android:id="@+id/productNotesInput"
                style="@style/SealCoffeeEditText"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:hint="@string/order_notes_optional"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="200"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true" />

            <LinearLayout
                android:id="@+id/productAddOnsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/add_ons"
                    android:textColor="@color/seal_text_primary"
                    android:textSize="18sp" />

                <CheckBox
                    android:id="@+id/addOnExtraShotCheckBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_on_extra_shot_price" />

                <CheckBox
                    android:id="@+id/addOnOatMilkCheckBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_on_oat_milk_price" />

                <CheckBox
                    android:id="@+id/addOnCaramelCheckBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_on_caramel_price" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/quantity"
                    android:textColor="@color/seal_text_primary"
                    android:textSize="18sp" />

                <ImageButton
                    android:id="@+id/productDecreaseButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/content_description_decrease_quantity"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_decrease_btn" />

                <TextView
                    android:id="@+id/productQuantityText"
                    android:layout_width="44dp"
                    android:layout_height="42dp"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:textColor="@color/seal_text_primary"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/productIncreaseButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/content_description_increase_quantity"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_increase_btn" />
            </LinearLayout>

            <TextView
                android:id="@+id/productPriceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/seal_navy"
                android:textSize="26sp" />

            <Button
                android:id="@+id/addToCartButton"
                style="@style/SealCoffeeButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/inter_extrabold"
                android:text="@string/add_to_cart"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/customerNavigation"
        layout="@layout/include_customer_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
