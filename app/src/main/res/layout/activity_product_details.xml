<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/productDetailsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/seal_cream"
    tools:context=".ProductDetailsActivity">

    <TextView
        android:id="@+id/productDetailsTitleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="sans-serif-black"
        android:text="Product Details"
        android:textColor="@color/seal_text_primary"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/productDetailsScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/customerNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/productDetailsTitleText">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:paddingBottom="22dp">

            <ImageView
                android:id="@+id/productImagePlaceholder"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_image_placeholder"
                android:gravity="center" />

            <TextView
                android:id="@+id/productNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/seal_text_primary"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/productCategoryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/seal_coffee"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/productDescriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/seal_text_secondary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif"
                android:text="Ingredients"
                android:textColor="@color/seal_text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/productIngredientsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/seal_text_secondary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif"
                android:text="Size"
                android:textColor="@color/seal_text_primary"
                android:textSize="18sp" />

            <RadioGroup
                android:id="@+id/productSizeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/productSizeRegular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Regular" />

                <RadioButton
                    android:id="@+id/productSizeLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="Large" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif"
                android:text="Add-ons"
                android:textColor="@color/seal_text_primary"
                android:textSize="18sp" />

            <CheckBox
                android:id="@+id/addOnExtraShotCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Extra espresso shot" />

            <CheckBox
                android:id="@+id/addOnOatMilkCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Oat milk" />

            <CheckBox
                android:id="@+id/addOnCaramelCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Caramel drizzle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:text="Quantity"
                    android:textColor="@color/seal_text_primary"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/productDecreaseButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_chip"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="-"
                    android:textColor="@color/seal_navy"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/productQuantityText"
                    android:layout_width="44dp"
                    android:layout_height="42dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:textColor="@color/seal_text_primary"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/productIncreaseButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_chip_selected"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="+"
                    android:textColor="@color/white"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/productPriceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/seal_navy"
                android:textSize="26sp" />

            <Button
                android:id="@+id/addToCartButton"
                style="@style/SealCoffeeButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="Add to Cart"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/customerNavigation"
        layout="@layout/include_customer_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
