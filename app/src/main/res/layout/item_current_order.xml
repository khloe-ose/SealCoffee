<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/SealCoffeeCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/currentOrderIdText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/seal_text_primary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/currentOrderTypeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/seal_text_secondary"
            android:textSize="14sp"
            android:textStyle="italic" />
    </LinearLayout>

    <TextView
        android:id="@+id/currentStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/inter_extrabold"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/seal_text_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/currentStatusDescriptionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/inter_medium"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/seal_text_primary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/currentItemsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/seal_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/currentTotalText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/seal_navy"
        android:textSize="16sp" />

</LinearLayout>