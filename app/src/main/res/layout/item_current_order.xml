<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/SealCoffeeCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="6dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Header: Order ID, Order Type, and Status Chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- ID and Order Type Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/currentOrderIdText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/seal_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/currentOrderTypeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter"
                android:textColor="@color/seal_text_secondary"
                android:textSize="13sp"
                android:textStyle="italic" />
        </LinearLayout>

        <!-- Status Chip -->
        <TextView
            android:id="@+id/currentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_selected"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/seal_navy"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Status Description Text (Active order specific detail) -->
    <TextView
        android:id="@+id/currentStatusDescriptionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/inter"
        android:textColor="@color/seal_text_primary"
        android:textSize="14sp" />

    <!-- Visual Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#E5E7EB" />

    <!-- Bottom Section: Items Summary and Total Price -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Order Items Summary -->
        <TextView
            android:id="@+id/currentItemsText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:fontFamily="@font/inter"
            android:textColor="@color/seal_text_secondary"
            android:textSize="14sp" />

        <!-- Total Price -->
        <TextView
            android:id="@+id/currentTotalText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:textColor="@color/seal_navy"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>