<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.SealCoffee" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/seal_cream</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:navigationBarColor">@color/seal_cream</item>
        <item name="android:statusBarColor">@color/seal_navy</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/seal_navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/seal_navy_pressed</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/seal_coffee</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/seal_surface</item>
        <item name="colorOnSurface">@color/seal_text_primary</item>
        <item name="colorSurfaceVariant">@color/seal_cream_dark</item>
        <item name="colorOnSurfaceVariant">@color/seal_text_secondary</item>
        <item name="colorOutline">@color/seal_input_stroke</item>
        <item name="colorError">@color/seal_error</item>
        <item name="android:colorAccent">@color/seal_navy</item>
    </style>
</resources>
